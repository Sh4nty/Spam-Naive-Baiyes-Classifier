+_GREETINGS = ["Hi,", "Hello,", "Hi there,", "Good morning,"]
+_SIGNOFFS = ["Best regards,\nSam", "Thanks,\nAlex", "Kind regards,\nJordan", "Cheers,\nChris"]
+_PADDING = [
