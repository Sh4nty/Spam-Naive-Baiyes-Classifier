@@ -0,0 +1,22 @@
+# Clean baselines (no attack)
+
+Spam is the positive class. Values are point estimates with 95% percentile bootstrap CIs (1000 resamples, seed 42). Smoothing alpha = 1.0, full vocabulary.
+
+## Data
+
+- Enron train: 23,600 messages, 50.9% spam, 1999-12-10 to 2005-06-08
+- Enron test: 9,938 messages, 50.1% spam, 2001-07-09 to 2005-09-06
+- SpamAssassin (external): 5,226 messages, 20.6% spam, 2001-06-25 to 2002-12-04
+
+Split: Enron-Spam ham ends in 2002 while spam runs to 2005, so one global cut leaves a 100%-spam test set. Each class is split at its own date: oldest 70% train, newest 30% test.
+
+Near-duplicates removed (5-word shingles, Jaccard >= 0.8): 178 Enron test messages that duplicate Enron training messages, and 820 SpamAssassin messages (820 of them spam) that duplicate Enron training messages. Enron-Spam's spam was partly drawn from the SpamAssassin corpus, so without this step SpamAssassin would not be an external test.
+
+## Results
+
+| Model | Test set | Precision | Recall | F1 | Accuracy | FPR | TP/FP/TN/FN |
+|---|---|---|---|---|---|---|---|
+| multinomial | Enron test | 0.963 [0.958, 0.968] | 0.971 [0.967, 0.976] | 0.967 [0.964, 0.970] | 0.967 [0.963, 0.970] | 0.038 [0.033, 0.043] | 4834/188/4773/143 |
+| multinomial | SpamAssassin (external) | 0.235 [0.223, 0.246] | 0.981 [0.974, 0.989] | 0.379 [0.363, 0.394] | 0.339 [0.327, 0.352] | 0.827 [0.815, 0.839] | 1056/3434/716/20 |
+| bernoulli | Enron test | 0.984 [0.980, 0.987] | 0.859 [0.850, 0.869] | 0.917 [0.912, 0.923] | 0.922 [0.917, 0.927] | 0.014 [0.011, 0.018] | 4277/71/4890/700 |
+| bernoulli | SpamAssassin (external) | 0.288 [0.273, 0.303] | 0.880 [0.859, 0.900] | 0.434 [0.415, 0.451] | 0.527 [0.514, 0.541] | 0.564 [0.548, 0.579] | 947/2341/1809/129 |
diff --git a/scripts/evaluate_a7.py b/scripts/evaluate_a7.py
new file mode 100644
index 0000000..fe081eb
--- /dev/null
+++ b/scripts/evaluate_a7.py
@@ -0,0 +1,146 @@
+"""Evaluate A7 rewrites against both victims.
+
+    python scripts/evaluate_a7.py                       # every generations file
+    python scripts/evaluate_a7.py data/a7/generations_X.jsonl
+
+Test set = Enron test ham + the A7 sample's spam (defanged originals).
+Each variant replaces the spam with its rewrites; a refused rewrite keeps
+the original (a failed attack). Reports before/after P/R/F1 with 95% CIs,
+ASR, edit cost, refusal rate, and which tokens explain the evasions.
+Writes results/a7_<tag>.md and .json.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+import numpy as np  # noqa: E402
+
+from spam_nb.experiment import MODELS, RESULTS, fit_victim, load_config, prepare_data  # noqa: E402
+from spam_nb.llm_camouflage import evasion_attribution, token_change_rate  # noqa: E402
+from spam_nb.metrics import evaluate  # noqa: E402
+from spam_nb.tokenizer import tokenize  # noqa: E402
+
+SAMPLE = ROOT / "data" / "a7" / "a7_sample.jsonl"
+METRICS = ["precision", "recall", "f1"]
+
+
+def ci(res, key, metric):
+    lo, hi = res[key]["ci"][metric]
+    return f"{res[key]['metrics'][metric]:.3f} [{lo:.3f}, {hi:.3f}]"
+
+
+def evaluate_file(path: Path, data, models, cfg) -> tuple[str, dict]:
+    sample = [json.loads(line) for line in open(SAMPLE)]
+    originals = {row["id"]: row["original"] for row in sample}
+    records = [json.loads(line) for line in open(path)]
+    meta = records[0]
+    variants = sorted({r["variant"] for r in records})
+
+    ham = data["enron_test"][data["enron_test"].label == 0]["text"].tolist()
+    spam = [row["original"] for row in sample]
+    docs = ham + spam
+    labels = [0] * len(ham) + [1] * len(spam)
+
+    lines = [
+        f"# A7 LLM camouflage: {meta['backend']} / {meta['model']}",
+        "",
+        f"Source: `{path.relative_to(ROOT)}` (prompt {meta.get('prompt_version', '?')}, "
+        f"temperature {meta.get('temperature', '-')}). Test set: {len(ham):,} Enron test ham + "
+        f"{len(spam)} sampled spam that both victims flag when clean (defanged, so the "
+        "'before' column already includes any effect of defanging). Refused rewrites "
+        "keep the original message.",
+        "",
+    ]
+    summary = {"backend": meta["backend"], "model": meta["model"], "variants": {}}
+
+    for variant in variants:
+        recs = {r["id"]: r for r in records if r["variant"] == variant}
+        missing = [i for i in originals if i not in recs]
+        refused = sum(r["refused"] for r in recs.values())
+        mapping = {
+            originals[i]: (recs[i]["rewrite"] if i in recs and not recs[i]["refused"]
+                           else originals[i])
+            for i in originals
+        }
+        pairs = [(originals[i], mapping[originals[i]]) for i in originals]
+        change = np.mean([token_change_rate(o, r) for o, r in pairs])
+        growth = np.mean([len(tokenize(r)) / max(1, len(tokenize(o))) - 1 for o, r in pairs])
+        kept = np.mean([recs[i]["placeholders_kept"] for i in recs]) if recs else 0.0
+
+        lines += [
+            f"## Variant: {variant}",
+            "",
+            f"- Rewrites: {len(recs)}/{len(originals)}"
+            + (f" ({len(missing)} missing: not generated yet)" if missing else "")
+            + f"; refused: {refused} ({refused / max(1, len(recs)):.1%})",
+            f"- Placeholders kept (pitch still actionable): {kept:.1%}",
+            f"- Mean normalised token edit distance: {change:.2f}; "
+            f"mean length change: {growth:+.0%}",
+            "",
+            "| Model | Precision before | after | Recall before | after | "
+            "F1 before | after | ASR |",
+            "|---|---|---|---|---|---|---|---|",
+        ]
+        variant_summary = {"refused": refused, "n": len(recs), "token_change": change,
+                           "placeholders_kept": kept, "models": {}}
+        attributions = []
+        for name, model in models.items():
+            res = evaluate(model, docs, labels, attack=lambda msgs: [mapping[m] for m in msgs],
+                           n_resamples=cfg["bootstrap_resamples"], seed=cfg["seed"])
+            lines.append(
+                f"| {name} | {ci(res, 'clean', 'precision')} | {ci(res, 'attacked', 'precision')} "
+                f"| {ci(res, 'clean', 'recall')} | {ci(res, 'attacked', 'recall')} "
+                f"| {ci(res, 'clean', 'f1')} | {ci(res, 'attacked', 'f1')} | {res['asr']:.3f} |"
+            )
+            variant_summary["models"][name] = {
+                "clean": res["clean"]["metrics"], "attacked": res["attacked"]["metrics"],
+                "clean_ci": res["clean"]["ci"], "attacked_ci": res["attacked"]["ci"],
+                "asr": res["asr"],
+            }
+            evaded = [(o, r) for o, r in pairs if model.margin([r])[0] <= 0]
+            if evaded:
+                attr = evasion_attribution(model, *zip(*evaded), top=12)
+                attributions.append((name, len(evaded), attr))
+
+        lines.append("")
+        for name, n_evaded, attr in attributions:
+            removed = ", ".join(f"{t} ({v:.0f})" for t, v in attr["removed_spam_evidence"])
+            added = ", ".join(f"{t} ({v:.0f})" for t, v in attr["added_ham_evidence"])
+            lines += [
+                f"**Why {n_evaded} messages evaded {name} NB** (summed change in "
+                "log-odds contribution across evaded messages):",
+                "",
+                f"- Spam evidence the rewrite removed: {removed}",
+                f"- Ham evidence the rewrite added: {added or '(none)'}",
+                "",
+            ]
+        summary["variants"][variant] = variant_summary
+    return "\n".join(lines), summary
+
+
+def main() -> int:
+    paths = [Path(p) for p in sys.argv[1:]] or sorted((ROOT / "data" / "a7").glob("generations_*.jsonl"))
+    if not paths:
+        print("No generations found. Run scripts/generate_a7.py first.")
+        return 1
+    cfg = load_config()
+    data = prepare_data(cfg)
+    models = {name: fit_victim(name, data, cfg) for name in MODELS}
+    RESULTS.mkdir(exist_ok=True)
+    for path in paths:
+        report, summary = evaluate_file(path.resolve(), data, models, cfg)
+        tag = path.stem.replace("generations_", "")
+        (RESULTS / f"a7_{tag}.md").write_text(report)
+        (RESULTS / f"a7_{tag}.json").write_text(json.dumps(summary, indent=2, default=float))
+        print(f"Wrote results/a7_{tag}.md")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/fetch_data.py b/scripts/fetch_data.py
new file mode 100644
index 0000000..e6120f2
--- /dev/null
+++ b/scripts/fetch_data.py
@@ -0,0 +1,118 @@
+"""Download the raw corpora into data/raw/ (which is gitignored).
+
+    python scripts/fetch_data.py
+
+Enron-Spam: the single-file release of Metsis et al. (2006) by
+MWiechmann/enron_spam_data, which keeps the arrival date from the original
+file names.
+
+SpamAssassin public corpus: the five official 2003/2005 tarballs from
+spamassassin.apache.org; if that site cannot be reached, the copy in
+github.com/stdlib-js/datasets-spam-assassin is cloned instead (same
+messages, different folder names; the loader handles both).
+
+Per the SpamAssassin corpus notice, never feed these messages into a live
+mail system.
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+import sys
+import tarfile
+import tempfile
+import urllib.request
+from pathlib import Path
+
+RAW = Path(__file__).resolve().parents[1] / "data" / "raw"
+
+ENRON_URL = (
+    "https://raw.githubusercontent.com/MWiechmann/enron_spam_data/"
+    "master/enron_spam_data.zip"
+)
+ENRON_REPO = "https://github.com/MWiechmann/enron_spam_data"
+SA_BASE = "https://spamassassin.apache.org/old/publiccorpus/"
+SA_FILES = [
+    "20030228_easy_ham.tar.bz2",
+    "20030228_easy_ham_2.tar.bz2",
+    "20030228_hard_ham.tar.bz2",
+    "20030228_spam.tar.bz2",
+    "20050311_spam_2.tar.bz2",
+]
+SA_MIRROR = "https://github.com/stdlib-js/datasets-spam-assassin"
+
+
+def download(url: str, dest: Path) -> None:
+    print(f"  downloading {url}")
+    request = urllib.request.Request(url, headers={"User-Agent": "spam-nb-fetch"})
+    with urllib.request.urlopen(request, timeout=120) as response, open(dest, "wb") as out:
+        shutil.copyfileobj(response, out)
+
+
+def fetch_enron() -> None:
+    dest = RAW / "enron_spam_data.zip"
+    if dest.exists():
+        print(f"Enron-Spam: already present at {dest}")
+        return
+    print("Enron-Spam:")
+    try:
+        download(ENRON_URL, dest)
+    except Exception as error:
+        print(f"  direct download failed ({error}); cloning the repository")
+        dest.unlink(missing_ok=True)
+        with tempfile.TemporaryDirectory() as tmp:
+            subprocess.run(
+                ["git", "clone", "--depth", "1", "--quiet", ENRON_REPO, tmp + "/repo"],
+                check=True,
+            )
+            shutil.copy(Path(tmp) / "repo" / "enron_spam_data.zip", dest)
+
+
+def _sa_official(dest: Path) -> None:
+    with tempfile.TemporaryDirectory() as tmp:
+        for name in SA_FILES:
+            archive = Path(tmp) / name
+            download(SA_BASE + name, archive)
+            with tarfile.open(archive) as tar:
+                tar.extractall(dest, filter="data")
+
+
+def _sa_mirror(dest: Path) -> None:
+    with tempfile.TemporaryDirectory() as tmp:
+        print(f"  cloning {SA_MIRROR}")
+        subprocess.run(
+            ["git", "clone", "--depth", "1", "--quiet", SA_MIRROR, tmp + "/repo"],
+            check=True,
+        )
+        for folder in (Path(tmp) / "repo" / "data").iterdir():
+            if folder.is_dir():
+                shutil.copytree(folder, dest / folder.name)
+
+
+def fetch_spamassassin() -> None:
+    dest = RAW / "spamassassin"
+    if dest.exists() and any(dest.iterdir()):
+        print(f"SpamAssassin: already present at {dest}")
+        return
+    print("SpamAssassin:")
+    dest.mkdir(parents=True, exist_ok=True)
+    try:
+        _sa_official(dest)
+    except Exception as error:  # site blocked or down: use the mirror
+        print(f"  official site failed ({error}); using the GitHub mirror")
+        shutil.rmtree(dest)
+        dest.mkdir(parents=True)
+        _sa_mirror(dest)
+
+
+def main() -> int:
+    RAW.mkdir(parents=True, exist_ok=True)
+    fetch_enron()
+    fetch_spamassassin()
+    print(f"Done. Raw data is in {RAW}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/generate_a7.py b/scripts/generate_a7.py
new file mode 100644
index 0000000..7a68e7a
--- /dev/null
+++ b/scripts/generate_a7.py
@@ -0,0 +1,189 @@
+"""A7 generation: rewrite the sampled spam with an LLM (or the fallback).
+
+Runs anywhere the repo is cloned (laptop or Colab); needs only the Python
+standard library plus numpy/pandas. Resumable: re-running skips messages
+already in the output file, so it is safe to stop and restart.
+
+Examples
+--------
+Ollama on a laptop (after `ollama pull llama3.1:8b`):
+    python scripts/generate_a7.py --backend ollama --model llama3.1:8b
+
+Any OpenAI-compatible API (key read from the environment, never the repo):
+    export LLM_API_KEY=...            # Windows: set LLM_API_KEY=...
+    # Groq
+    python scripts/generate_a7.py --backend openai \
+        --base-url https://api.groq.com/openai/v1 --model llama-3.1-8b-instant
+    # Google Gemini (OpenAI-compatible endpoint)
+    python scripts/generate_a7.py --backend openai \
+        --base-url https://generativelanguage.googleapis.com/v1beta/openai \
+        --model gemini-2.0-flash
+    # OpenRouter
+    python scripts/generate_a7.py --backend openai \
+        --base-url https://openrouter.ai/api/v1 --model meta-llama/llama-3.1-8b-instruct
+
+Rule-based fallback (no LLM):
+    python scripts/generate_a7.py --backend rule
+
+Output: data/a7/generations_<backend>_<model>.jsonl, one JSON object per
+(message, variant) with the rewrite, refusal flag and safety checks.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sys
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+from spam_nb.llm_camouflage import (  # noqa: E402
+    PROMPTS,
+    SYSTEM_PROMPT,
+    clean_response,
+    has_live_contact,
+    is_refusal,
+    placeholders_kept,
+    rule_based_rewrite,
+)
+
+SAMPLE = ROOT / "data" / "a7" / "a7_sample.jsonl"
+PROMPT_VERSION = "v1"
+
+
+def _post(url: str, payload: dict, headers: dict, timeout: int = 180) -> dict:
+    request = urllib.request.Request(
+        url,
+        data=json.dumps(payload).encode(),
+        headers={"Content-Type": "application/json", **headers},
+        method="POST",
+    )
+    with urllib.request.urlopen(request, timeout=timeout) as response:
+        return json.loads(response.read())
+
+
+def call_llm(args, prompt: str) -> str:
+    messages = [
+        {"role": "system", "content": SYSTEM_PROMPT},
+        {"role": "user", "content": prompt},
+    ]
+    if args.backend == "ollama":
+        reply = _post(
+            args.base_url.rstrip("/") + "/api/chat",
+            {"model": args.model, "messages": messages, "stream": False,
+             "options": {"temperature": args.temperature, "seed": args.seed}},
+            {},
+        )
+        return reply["message"]["content"]
+
+    key = os.environ.get(args.api_key_env, "")
+    if not key:
+        raise SystemExit(f"Set the {args.api_key_env} environment variable to your API key.")
+    reply = _post(
+        args.base_url.rstrip("/") + "/chat/completions",
+        {"model": args.model, "messages": messages, "temperature": args.temperature,
+         "max_tokens": args.max_tokens, "seed": args.seed},
+        {"Authorization": f"Bearer {key}"},
+    )
+    return reply["choices"][0]["message"]["content"] or ""
+
+
+def generate_one(args, message: str, variant: str, index: int) -> tuple[str, str]:
+    """Return (raw response, cleaned rewrite)."""
+    if args.backend == "rule":
+        text = rule_based_rewrite(message, variant, seed=args.seed + index)
+        return text, text
+    prompt = PROMPTS[variant].format(message=message)
+    delay = 5.0
+    for attempt in range(6):
+        try:
+            raw = call_llm(args, prompt)
+            return raw, clean_response(raw)
+        except urllib.error.HTTPError as error:
+            body = error.read().decode(errors="replace")[:300]
+            if error.code in (429, 500, 502, 503, 504) and attempt < 5:
+                print(f"    HTTP {error.code}; retrying in {delay:.0f}s")
+                time.sleep(delay)
+                delay *= 2
+                continue
+            raise SystemExit(f"HTTP {error.code} from the LLM: {body}")
+        except (urllib.error.URLError, TimeoutError) as error:
+            if attempt < 5:
+                print(f"    {error}; retrying in {delay:.0f}s")
+                time.sleep(delay)
+                delay *= 2
+                continue
+            raise
+    raise RuntimeError("unreachable")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    parser.add_argument("--backend", choices=["ollama", "openai", "rule"], required=True)
+    parser.add_argument("--model", default="rule-based-v1")
+    parser.add_argument("--base-url", default="http://localhost:11434",
+                        help="Ollama server, or the OpenAI-compatible API base URL")
+    parser.add_argument("--api-key-env", default="LLM_API_KEY")
+    parser.add_argument("--variants", nargs="+", default=list(PROMPTS), choices=list(PROMPTS))
+    parser.add_argument("--n", type=int, default=None, help="only the first n messages")
+    parser.add_argument("--temperature", type=float, default=0.7)
+    parser.add_argument("--max-tokens", type=int, default=1024)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--sleep", type=float, default=0.0,
+                        help="pause between calls (free-tier rate limits)")
+    parser.add_argument("--sample", type=Path, default=SAMPLE)
+    parser.add_argument("--out", type=Path, default=None)
+    args = parser.parse_args()
+
+    if args.backend == "rule":
+        args.model = "rule-based-v1"
+    tag = re.sub(r"[^A-Za-z0-9.-]+", "-", f"{args.backend}_{args.model}").strip("-")
+    out = args.out or ROOT / "data" / "a7" / f"generations_{tag}.jsonl"
+
+    sample = [json.loads(line) for line in open(args.sample)]
+    if args.n:
+        sample = sample[: args.n]
+
+    done = set()
+    if out.exists():
+        done = {(r["id"], r["variant"]) for r in map(json.loads, open(out))}
+    todo = [(i, row, v) for i, row in enumerate(sample) for v in args.variants
+            if (row["id"], v) not in done]
+    print(f"{len(done)} already done, {len(todo)} to go -> {out}")
+
+    out.parent.mkdir(parents=True, exist_ok=True)
+    refusals = 0
+    with open(out, "a") as fh:
+        for count, (i, row, variant) in enumerate(todo, 1):
+            start = time.time()
+            raw, rewrite = generate_one(args, row["original"], variant, i)
+            refused = is_refusal(rewrite)
+            refusals += refused
+            record = {
+                "id": row["id"], "variant": variant, "backend": args.backend,
+                "model": args.model, "prompt_version": PROMPT_VERSION,
+                "temperature": args.temperature, "seed": args.seed,
+                "rewrite": rewrite, "raw": raw, "refused": refused,
+                "placeholders_kept": placeholders_kept(row["original"], rewrite),
+                "live_contact": has_live_contact(rewrite),
+                "seconds": round(time.time() - start, 2),
+            }
+            fh.write(json.dumps(record) + "\n")
+            fh.flush()
+            if count % 25 == 0 or count == len(todo):
+                print(f"  {count}/{len(todo)}  refusals so far: {refusals}")
+            if args.sleep:
+                time.sleep(args.sleep)
+    print(f"Done: {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/prepare_a7.py b/scripts/prepare_a7.py
new file mode 100644
index 0000000..46c2994
--- /dev/null
+++ b/scripts/prepare_a7.py
@@ -0,0 +1,45 @@
+"""Build the A7 input sample: 300 defanged spam messages that both victims
+flag when clean.
+
+    python scripts/prepare_a7.py [--n 300]
+
+Writes data/a7/a7_sample.jsonl (tracked in git, so teammates can run the
+LLM generation step without the full data pipeline).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from spam_nb.experiment import MODELS, ROOT, fit_victim, load_config, prepare_data  # noqa: E402
+from spam_nb.llm_camouflage import has_live_contact, sample_spam  # noqa: E402
+
+OUT = ROOT / "data" / "a7" / "a7_sample.jsonl"
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--n", type=int, default=300)
+    args = parser.parse_args()
+
+    cfg = load_config()
+    data = prepare_data(cfg)
+    models = [fit_victim(name, data, cfg) for name in MODELS]
+    sample = sample_spam(data["enron_test"], models, n=args.n, seed=cfg["seed"])
+    assert not any(has_live_contact(t) for t in sample.original), "defanging failed"
+
+    OUT.parent.mkdir(parents=True, exist_ok=True)
+    with open(OUT, "w") as fh:
+        for row in sample.itertuples(index=False):
+            fh.write(json.dumps({"id": row.id, "original": row.original}) + "\n")
+    print(f"Wrote {len(sample)} messages to {OUT}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/run_attacks.py b/scripts/run_attacks.py
new file mode 100644
index 0000000..0f005eb
--- /dev/null
+++ b/scripts/run_attacks.py
@@ -0,0 +1,277 @@
+"""Good-word attacks A1-A3 against both NB variants on the Enron test set.
+
+    python scripts/run_attacks.py [--seeds 5]
+
+Writes:
+  results/attacks_a1_a3.csv     one row per model x attack x budget (x seed)
+  results/attacks_a1_a3.md      summary tables for the report
+  results/attacks_f1_vs_budget.png
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+import numpy as np  # noqa: E402
+import pandas as pd  # noqa: E402
+
+from spam_nb.attacks import (  # noqa: E402
+    breaking_point,
+    common_word_padding,
+    estimate_good_words,
+    min_good_words,
+    passive_good_word,
+    random_padding,
+    robustness_auc,
+    whitebox_distinct,
+    whitebox_repeat,
+    word_frequencies,
+)
+from spam_nb.experiment import (  # noqa: E402
+    MODELS,
+    RESULTS,
+    fit_victim,
+    load_config,
+    prepare_data,
+)
+from spam_nb.metrics import evaluate  # noqa: E402
+
+BUDGETS = [0, 5, 10, 20, 50, 100, 200, 500]
+HEADLINE_BUDGET = 50
+ATTACK_LABELS = {
+    "A1-random": "A1 random padding (T1, control)",
+    "A1-common": "A1 common-word padding (T1, control)",
+    "A2": "A2 passive good-word (T2)",
+    "A3-distinct": "A3 white-box, distinct words (T4)",
+    "A3-repeat": "A3 white-box, one word repeated (T4)",
+}
+
+
+def build_attacks(model_name, model, pools, budget, seed):
+    attacks = {
+        "A1-random": random_padding(pools["random"], budget, seed=seed),
+        "A1-common": common_word_padding(pools["common"], budget),
+        "A2": passive_good_word(pools["good"], budget),
+        "A3-distinct": whitebox_distinct(model, budget),
+    }
+    if model_name == "multinomial":
+        attacks["A3-repeat"] = whitebox_repeat(model, budget)
+    return attacks
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--seeds", type=int, default=5,
+                        help="seeds for the randomised attack A1-random")
+    args = parser.parse_args()
+
+    cfg = load_config()
+    start = time.time()
+    data = prepare_data(cfg)
+    test = data["enron_test"]
+    docs, labels = test["text"].tolist(), test["label"].to_numpy()
+
+    # Attacker-side resources: only the attacker's own public corpora.
+    common, counts = word_frequencies(data["attacker_ham"]["text"])
+    pools = {
+        "common": common,
+        "random": [w for w, c in zip(common, counts) if c >= 2],
+        "good": [w for w, _ in estimate_good_words(
+            data["attacker_ham"]["text"], data["attacker_spam"]["text"])],
+    }
+
+    rows, summaries, bstar_rows, examples = [], [], [], []
+    for model_name in MODELS:
+        model = fit_victim(model_name, data, cfg)
+        clean = evaluate(model, docs, labels, n_resamples=0)
+        clean_m = clean["clean"]["metrics"]
+        attackable = (labels == 1) & (clean["clean_margin"] > 0)
+        spam_docs = [d for d, a in zip(docs, attackable) if a]
+
+        # Analytic minimum effort on the attackable set.
+        modes = ["distinct"] + (["repeat"] if model_name == "multinomial" else [])
+        for mode in modes:
+            b = min_good_words(model, spam_docs, mode=mode)
+            finite = b[np.isfinite(b)]
+            bstar_rows.append({
+                "model": model_name, "mode": mode,
+                "median": float(np.median(finite)),
+                "p10": float(np.percentile(finite, 10)),
+                "p90": float(np.percentile(finite, 90)),
+                "flippable_within_50": float(np.mean(b <= 50)),
+                "flippable_within_500": float(np.mean(b <= 500)),
+            })
+
+        # What the two knowledge levels pick as "good words".
+        a3_words = [str(model.feature_names_[i]) for i in np.argsort(model.weights_)
+                    if str(model.feature_names_[i]).isalpha()][:10]
+        a2_weights = [
+            (w, model.weights_[model.vocabulary_[w]]) if w in model.vocabulary_ else (w, None)
+            for w in pools["good"][:10]
+        ]
+        examples.append((model_name, a3_words, a2_weights))
+
+        for budget in BUDGETS:
+            seeds = range(args.seeds)
+            for seed in seeds:
+                for name, attack in build_attacks(model_name, model, pools, budget, seed).items():
+                    if name != "A1-random" and seed > 0:
+                        continue  # deterministic attacks run once
+                    res = evaluate(model, docs, labels, attack=attack, n_resamples=0)
+                    m = res["attacked"]["metrics"]
+                    rows.append({
+                        "model": model_name, "attack": name, "budget": budget, "seed": seed,
+                        "precision": m["precision"], "recall": m["recall"], "f1": m["f1"],
+                        "asr": res["asr"], "tokens_added": res["tokens_added"],
+                        "clean_f1": clean_m["f1"], "clean_recall": clean_m["recall"],
+                    })
+            print(f"{model_name:12s} budget {budget:4d} done ({time.time() - start:.0f}s)")
+
+        # Bootstrap CIs at the headline budget.
+        for name, attack in build_attacks(model_name, model, pools, HEADLINE_BUDGET, 0).items():
+            res = evaluate(model, docs, labels, attack=attack,
+                           n_resamples=cfg["bootstrap_resamples"], seed=cfg["seed"])
+            summaries.append({
+                "model": model_name, "attack": name,
+                "recall": res["attacked"]["metrics"]["recall"],
+                "recall_ci": res["attacked"]["ci"]["recall"],
+                "f1": res["attacked"]["metrics"]["f1"],
+                "f1_ci": res["attacked"]["ci"]["f1"],
+                "asr": res["asr"],
+            })
+
+    df = pd.DataFrame(rows)
+    RESULTS.mkdir(exist_ok=True)
+    df.to_csv(RESULTS / "attacks_a1_a3.csv", index=False)
+
+    # Average the randomised attack over seeds for the curves.
+    curves = df.groupby(["model", "attack", "budget"], as_index=False).agg(
+        f1=("f1", "mean"), f1_sd=("f1", "std"), recall=("recall", "mean"),
+        precision=("precision", "mean"), asr=("asr", "mean"), clean_f1=("clean_f1", "first"),
+    )
+
+    write_report(curves, summaries, bstar_rows, examples, args.seeds)
+    plot(curves)
+    print(f"Done in {time.time() - start:.0f}s")
+    return 0
+
+
+def write_report(curves, summaries, bstar_rows, examples, n_seeds):
+    lines = [
+        "# Good-word attacks A1-A3 (Enron test set)",
+        "",
+        "Victims trained on the Enron training split, full vocabulary, alpha = 1. "
+        "Attacks append words to every spam message in the Enron test set; ham "
+        "is untouched. Budget = tokens appended per message. ASR is measured on "
+        "the spam each model flags when clean. "
+        f"A1-random is averaged over {n_seeds} seeds; the other attacks are deterministic. "
+        "A1 and A2 draw only on the attacker's own corpora (SpamAssassin ham and "
+        "spam, disjoint from the victim's training data); A3 reads the victim's weights.",
+        "",
+        "## F1 by budget",
+        "",
+    ]
+    for model in curves.model.unique():
+        sub = curves[curves.model == model]
+        table = sub.pivot(index="attack", columns="budget", values="f1")
+        clean = sub.clean_f1.iloc[0]
+        lines += [f"### {model} (clean F1 = {clean:.3f})", "",
+                  "| Attack | " + " | ".join(f"b={b}" for b in table.columns)
+                  + " | Breaking point | Robustness AUC |",
+                  "|---|" + "---|" * (len(table.columns) + 2)]
+        for attack in [a for a in ATTACK_LABELS if a in table.index]:
+            f1 = table.loc[attack].to_numpy()
+            bp = breaking_point(list(table.columns), f1, clean)
+            auc = robustness_auc(list(table.columns), f1, clean)
+            lines.append(
+                f"| {ATTACK_LABELS[attack]} | " + " | ".join(f"{v:.3f}" for v in f1)
+                + f" | {bp if bp is not None else '> 500'} | {auc:.3f} |"
+            )
+        lines.append("")
+
+    lines += [
+        f"## Headline: budget {HEADLINE_BUDGET} with 95% bootstrap CIs",
+        "",
+        "| Model | Attack | Recall | F1 | ASR |",
+        "|---|---|---|---|---|",
+    ]
+    for s in summaries:
+        lines.append(
+            f"| {s['model']} | {ATTACK_LABELS[s['attack']]} | {s['recall']:.3f} "
+            f"[{s['recall_ci'][0]:.3f}, {s['recall_ci'][1]:.3f}] | {s['f1']:.3f} "
+            f"[{s['f1_ci'][0]:.3f}, {s['f1_ci'][1]:.3f}] | {s['asr']:.3f} |"
+        )
+
+    lines += [
+        "",
+        "## Analytic minimum effort b*(d) on the attackable spam",
+        "",
+        "b*(d) = fewest appended good words that flip message d, computed from the "
+        "true weights (distinct: greedy over the most negative w_t; repeat: "
+        "ceil(S(d)/|w_min|)). The tests check it is exact.",
+        "",
+        "| Model | Mode | Median | 10th pct | 90th pct | Flippable with <= 50 | <= 500 |",
+        "|---|---|---|---|---|---|---|",
+    ]
+    for r in bstar_rows:
+        lines.append(
+            f"| {r['model']} | {r['mode']} | {r['median']:.0f} | {r['p10']:.0f} | "
+            f"{r['p90']:.0f} | {r['flippable_within_50']:.1%} | {r['flippable_within_500']:.1%} |"
+        )
+
+    lines += ["", "## What each attacker picks as 'good words'", ""]
+    for model, a3, a2 in examples:
+        a2_txt = ", ".join(
+            f"{w} ({wt:+.2f})" if wt is not None else f"{w} (not in vocab)" for w, wt in a2
+        )
+        lines += [
+            f"- **{model}**, A3 white-box top 10: {', '.join(a3)}",
+            f"- **{model}**, A2 passive top 10 with the victim's true weight "
+            f"(negative = hammy): {a2_txt}",
+        ]
+    lines.append("")
+    (RESULTS / "attacks_a1_a3.md").write_text("\n".join(lines))
+
+
+def plot(curves):
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    models = list(curves.model.unique())
+    fig, axes = plt.subplots(1, len(models), figsize=(6 * len(models), 4.2), sharey=True)
+    styles = {
+        "A1-random": ("#9e9e9e", "--"), "A1-common": ("#616161", ":"),
+        "A2": ("#1f77b4", "-"), "A3-distinct": ("#d62728", "-"), "A3-repeat": ("#ff7f0e", "-."),
+    }
+    for ax, model in zip(np.atleast_1d(axes), models):
+        sub = curves[curves.model == model]
+        for attack, (color, ls) in styles.items():
+            s = sub[sub.attack == attack]
+            if s.empty:
+                continue
+            x = s.budget.replace(0, 1)  # log axis: plot b=0 at 1
+            ax.plot(x, s.f1, ls, color=color, marker="o", ms=3, label=ATTACK_LABELS[attack])
+        clean = sub.clean_f1.iloc[0]
+        ax.axhline(clean / 2, color="black", lw=0.6, alpha=0.5)
+        ax.text(1.05, clean / 2 + 0.02, "half of clean F1", fontsize=7, alpha=0.7)
+        ax.set_xscale("log")
+        ax.set_title(f"{model} NB (clean F1 {clean:.3f})")
+        ax.set_xlabel("Words appended per spam message (b=0 shown at 1)")
+        ax.set_ylim(0, 1)
+        ax.grid(alpha=0.3)
+    axes = np.atleast_1d(axes)
+    axes[0].set_ylabel("F1 on Enron test")
+    # Legend on the panel with the most curves (multinomial has A3-repeat).
+    max(axes, key=lambda a: len(a.get_lines())).legend(fontsize=7, loc="lower left")
+    fig.tight_layout()
+    fig.savefig(RESULTS / "attacks_f1_vs_budget.png", dpi=150)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
